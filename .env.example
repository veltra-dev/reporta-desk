# ==========================================
# TaskCloud Helpdesk - Configurações de Ambiente
# ==========================================

# 1. Integração com Repositório Privado no GitHub
# Crie um Personal Access Token (Classic) com escopo 'repo' ou um Fine-grained token com permissão 'Issues: Read & Write'
GITHUB_TOKEN=ghp_seu_token_secreto_aqui
GITHUB_OWNER=sua-organizacao-ou-usuario
GITHUB_REPO=nome-do-repositorio-privado

# 2. Notificações Transacionais por E-mail (Resend)
# Obtenha em https://resend.com/api-keys
RESEND_API_KEY=re_sua_chave_resend_aqui
RESEND_FROM_EMAIL=suporte@seudominio.com

# 3. Segredo de Sessão
SESSION_SECRET=uma_chave_longa_e_aleatoria_para_criptografia
